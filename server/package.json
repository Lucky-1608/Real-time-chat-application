{
  "name": "chat-app-server",
  "version": "1.0.0",
  "description": "Real-time chat application backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate:rooms": "node src/scripts/migrateRooms.js",
    "migrate:workspaces": "node src/scripts/migrateWorkspaces.js",
    "seed": "node src/scripts/seed.js",
    "openapi:generate": "node src/scripts/generateOpenapi.js",
    "openapi:check": "node src/scripts/generateOpenapi.js --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "clamscan": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "otplib": "^13.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.19.0",
    "globals": "^15.15.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
