PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat-app?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars
CLIENT_URL=http://localhost:5173

# Optional: S3-compatible object storage (AWS S3 or Cloudflare R2) for file/image uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=pulsechat-uploads
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# Optional: Anthropic Claude API for "Catch me up" room summaries
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Session & token settings
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_IDLE_DAYS=7
REFRESH_GRACE_MS=10000
# COOKIE_SAME_SITE=lax  # defaults to 'none' in production, 'lax' in development/test

# Password hashing (argon2id) & HIBP check
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# PASSWORD_PEPPER=optional-hmac-secret  # WARNING: losing this invalidates all existing password hashes
HIBP_ENABLED=true

# Field-level encryption (AES-256-GCM) for TOTP secrets and sensitive fields
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=replace-with-a-secure-random-string-at-least-32-chars

# Flood control (minutes new accounts are restricted from DMs/uploads)
NEW_ACCOUNT_RESTRICTION_MINUTES=10

# Optional ClamAV daemon for quarantine upload scanning
CLAMD_HOST=
CLAMD_PORT=3310
SCAN_POLL_INTERVAL_MS=2000

# Observability & Feature Flags
LOG_LEVEL=info
SENTRY_DSN=
APP_VERSION=1.0.0
FLAG_SCHEDULED_MESSAGES=true
FLAG_POLLS=true
FLAG_UPLOADS=true
FLAG_AI_SUMMARIES=true
